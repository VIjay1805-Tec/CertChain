          application_deadline: null,
        }),
      });

      const result = await response.json(); console.log('LOGIN RESPONSE:', result);

      if (!response.ok || !result.success || !result.job) {
        throw new Error(result.message || 'Failed to post job');
      }

      const j = result.job;

      const newJob: Job = {
        id: String(j.id),
        company_id: String(j.company_id),
        title: j.title || '',
        description: j.description || '',
        requirements: j.skills || j.experience_required || '',
        location: j.location || '',
        salary_range:
          j.salary_min != null || j.salary_max != null
            ? `${j.salary_min ?? ''}${j.salary_min != null && j.salary_max != null ? ' - ' : ''}${j.salary_max ?? ''}`
            : '',
        created_at: j.created_at || nowISO(),
      };

      setJobs((prev) => [...prev, newJob]);
      pushToast('Job posted successfully', 'success');
    } catch (error) {
      console.error('Company job posting failed:', error);
      pushToast(
        error instanceof Error ? error.message : 'Failed to post job',
        'error'
      );
    }
  }, [session, pushToast]);

  // ---- Company: Request Verification (paid tier) ----
  // ---- Company: Request Verification (real backend) ----
const requestVerification = useCallback(
  async (
    applicationId: string,
    tier: VerificationTier,
  ): Promise<Verification> => {
    if (!session) throw new Error('No session');

    const comp = session.entity as Company;

    const app = applications.find((a) => a.id === applicationId);
    if (!app) throw new Error('Application not found');

    const cert = certificates.find((c) => c.id === app.certificate_id);
    if (!cert && !app.sha256_hash && !app.original_file_name) {
      throw new Error('No certificate found');
    }

    // ============================================================
    // REAL BACKEND REQUEST
    // ============================================================

    const response = await fetch(
      `http://localhost:5000/api/companies/me/applications/${applicationId}/verification-request`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-user-id': session.user.id,
      'x-user-email': session.user.email,
        },
        body: JSON.stringify({
          verification_type: tier,
        }),
      },
    );

    const data = await response.json();

    if (!response.ok) {
      throw new Error(
        data?.message || 'Failed to create verification request',
      );
    }

    const backendRequest = data.verification_request;

    if (!backendRequest) {
      throw new Error(
        'Backend did not return a verification_request',
      );
    }

    // ============================================================
    // Convert backend response into the existing frontend
    // Verification structure.
    //
    // This means your existing UI does NOT need to change.
    // ============================================================

    const prices: Record<VerificationTier, number> = {
      blockchain: 999,
      ai_forgery: 1999,
      combined: 2999,
    };

    const verification: Verification = {
      id: String(backendRequest.id),

      application_id: applicationId,

      company_id: comp.id,

      student_id: app.student_id,

      institute_id: app.institute_id,

      tier,

      amount_paid: prices[tier],

      // Backend has only CREATED the request.
      // Payment is handled by your existing backend payment route.
      payment_status: 'pending',

      blockchain_check: {
        performed: false,

        // IMPORTANT:
        // This is the REAL certificate hash coming from your
        // certificate/backend data, NOT a mock hash.
        stored_hash: cert?.sha256_hash || app.sha256_hash || '',

        stored_cid: cert?.ipfs_cid || app.ipfs_cid || '',

        document_hash: cert?.sha256_hash || app.sha256_hash || '',

        match: null,
      },

      ai_forgery_check: {
        performed: false,

        result: null,

        confidence_score: null,
        forgery_probability: null,

        indicators: [],
      },

      verdict: null,

      confidence: null,

      blockchain_proof_ref: null,

      report_generated_at: null,

      created_at:
        backendRequest.created_at || nowISO(),
    };

    // ============================================================
    // Update local frontend state
    // ============================================================

    setVerifications((prev) => {
      // Prevent duplicate verification entries
      const alreadyExists = prev.some(
        (v) => v.id === verification.id,
      );

      if (alreadyExists) {
        return prev.map((v) =>
          v.id === verification.id ? verification : v,
        );
      }

      return [...prev, verification];
    });

    // ============================================================
    // Update application stage
    // ============================================================

    setApplications((prev) =>
      prev.map((a) =>
        a.id === applicationId
          ? {
              ...a,
              stage: 'verification_requested',
            }
          : a,
      ),
    );

    // ============================================================
    // Notify institute
    // ============================================================

    addNotification({
          recipient_role: 'student',

      recipient_id: app.institute_id,

      type: 'verification_requested',

      title: 'Verification Requested',

      message: `${comp.name} has requested verification for a student's certificate.`,

      application_id: applicationId,

      student_id: app.student_id,

      job_id: app.job_id,
    });

    // ============================================================
    // Toast
    // ============================================================

    pushToast(
      'Certificate verification request created successfully',
      'success',
    );

    // ============================================================
    // IMPORTANT:
    //
    // DO NOT run:
    //
    // verifyOnChain(...)
    // detectForgery(...)
    // computeVerdict(...)
    // mockTxHash(...)
    //
    // here.
    //
    // The backend now controls the real verification workflow.
    // ============================================================

    return verification;
  },
  [
    session,
    applications,
    certificates,
    addNotification,
    pushToast,
  ],
);

  const payForVerification = useCallback(async (verificationId: string): Promise<void> => {
    if (!session) throw new Error('Not authenticated');

    const loadRazorpay = (): Promise<void> =>
      new Promise((resolve, reject) => {
        if (window.Razorpay) {
          resolve();
          return;
        }

        const existingScript = document.querySelector(
          'script[src="https://checkout.razorpay.com/v1/checkout.js"]',
        );

        if (existingScript) {
          existingScript.addEventListener('load', () => resolve(), { once: true });
          existingScript.addEventListener(
            'error',
            () => reject(new Error('Failed to load Razorpay Checkout.')),
            { once: true },
          );
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://checkout.razorpay.com/v1/checkout.js';
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error('Failed to load Razorpay Checkout.'));
        document.body.appendChild(script);
      });

    await loadRazorpay();

    const orderResponse = await apiRequest<any>(
      `/companies/me/verification-requests/${verificationId}/payment/order`,
      {
        method: 'POST',
        headers: {
          'x-user-id': session.user.id,
          'x-user-email': session.user.email,
        },
        body: JSON.stringify({}),
      },
    );

    const order = orderResponse.order;

    if (!order?.id || !orderResponse.key_id) {
      throw new Error('Invalid Razorpay order response.');
    }

    await new Promise<void>((resolve, reject) => {
      let settled = false;

      const finish = (callback: () => void) => {
        if (settled) return;
        settled = true;
        callback();
      };

      const razorpay = new window.Razorpay({
        key: orderResponse.key_id,
        amount: order.amount,
        currency: order.currency,
        name: 'CertChain',
        description: 'Certificate verification payment',
        order_id: order.id,
        prefill: {
          email: session.user.email,
        },
        notes: {
          verification_request_id: verificationId,
        },
        handler: async (paymentResponse: {
          razorpay_payment_id: string;
          razorpay_order_id: string;
          razorpay_signature: string;
        }) => {
          try {
            const verifyResponse = await apiRequest<any>(
              `/companies/me/verification-requests/${verificationId}/payment/verify`,
              {
                method: 'POST',
                headers: {
                  'x-user-id': session.user.id,
                  'x-user-email': session.user.email,
                },
                body: JSON.stringify(paymentResponse),
              },
            );

            setVerifications((prev) =>
              prev.map((v) =>
                v.id === verificationId
                  ? { ...v, payment_status: 'completed' }
                  : v,
              ),
            );

            pushToast(
              verifyResponse.message || 'Payment completed successfully',
              'success',
            );

            finish(resolve);
          } catch (error) {
            finish(() =>
              reject(
                error instanceof Error
                  ? error
                  : new Error('Payment verification failed.'),
              ),
            );
          }
        },
        modal: {
          ondismiss: () => {
            finish(() => reject(new Error('Payment was cancelled.')));
          },
        },
      });

      razorpay.on('payment.failed', (failureResponse: any) => {
        finish(() =>
          reject(
            new Error(
              failureResponse?.error?.description || 'Payment failed.',
            ),
          ),
        );
      });

      razorpay.open();
    });
  }, [session, pushToast]);
  const verifyOnBlockchain = useCallback(async (verificationId: string, certificateFile: File): Promise<void> => {
    if (!session) throw new Error('Not authenticated');

    let response: any;
    try {
      response = await apiRequest<any>(`/companies/me/verification-requests/${verificationId}/blockchain-verify`, {
        method: 'POST',
        headers: {
          'x-user-id': session.user.id,
          'x-user-email': session.user.email,
        },
        body: (() => { const formData = new FormData(); formData.append("certificate", certificateFile); return formData; })(),
      });
    } catch (error) {
      const apiError = error as Error & { status?: number; data?: any };
      const failure = apiError.data;
      if (apiError.status === 422 && failure?.verdict === 'invalid') {
        setVerifications((prev) => prev.map((v) => v.id === verificationId ? {
          ...v,
          payment_status: 'completed',
          blockchain_check: { ...v.blockchain_check, performed: true, match: false, document_hash: String(failure.submitted_sha256_hash || "") },
          verdict: 'invalid',
          confidence: 0,
          report_generated_at: nowISO(),
        } : v));
      }
      throw error;
    }

    const updatedRequest = response.verification_request;
    const verification = verifications.find((v) => v.id === verificationId);
    const application = verification
      ? applications.find((a) => a.id === verification.application_id)
      : undefined;

    if (updatedRequest) {
      setVerifications((prev) =>
        prev.map((v) =>
          v.id === verificationId
            ? {
                ...v,
                payment_status: 'completed',
                blockchain_check: {
                  ...v.blockchain_check,
                  performed: true,
                  match: response.verified ?? null,
                },
                verdict: response.verdict ?? (response.verified ? 'verified' : 'invalid'),
                confidence: response.confidence ?? (response.verified ? 100 : 0),
                blockchain_proof_ref:
                  response.transaction_hash ||
                  response.tx_hash ||
                  v.blockchain_proof_ref,
              }
            : v,
        ),
      );
    }

    if (application) {
      const alreadyNotified = notifications.some(
        (n) =>
          n.type === 'verification_result_student' &&
          n.application_id === application.id,
      );

      if (!alreadyNotified) {
        const verdict = response.verdict ?? (response.verified ? 'verified' : 'invalid');

        addNotification({
          recipient_role: 'student',
          recipient_id: application.student_id,
          type: 'verification_result_student',
          title: 'Verification Result',
          message: `Your certificate verification result is ${String(verdict).toUpperCase()}.`,
          application_id: application.id,
          student_id: application.student_id,
          job_id: application.job_id,
        });
      }
    }

    pushToast(response.message || 'Blockchain verification completed', 'success');
  }, [
    session,
    verifications,
    applications,
    notifications,
    addNotification,
    pushToast,
  ]);  // ---- Notifications ----
    const verifyWithAI = useCallback(async (verificationId: string): Promise<void> => {
      if (!session) throw new Error('Not authenticated');

      const response = await apiRequest<any>(`/companies/me/verification-requests/${verificationId}/ai-verify`, {
        method: 'POST',
        headers: {
          'x-user-id': session.user.id,
          'x-user-email': session.user.email,
        },
        body: JSON.stringify({}),
      });

      const aiVerification = response.ai_verification;
      const verification = verifications.find((v) => v.id === verificationId);
      const application = verification
        ? applications.find((a) => a.id === verification.application_id)
        : undefined;

      if (aiVerification) {
        setVerifications((prev) =>
          prev.map((v) =>
            v.id === verificationId
              ? {
                  ...v,
                  payment_status: 'completed',
                  ai_forgery_check: {
                    ...v.ai_forgery_check,
                    performed: true,
                    result:
                      aiVerification.verdict === 'genuine'
                        ? 'genuine'
                        : aiVerification.verdict === 'suspicious'
                          ? 'suspicious'
                          : aiVerification.verdict === 'forged'
                            ? 'forged'
                            : null,
                    confidence_score: aiVerification.confidence_score ?? null,
                    forgery_probability: aiVerification.forgery_probability ?? null,
                    indicators: aiVerification.indicators || [],
                  },
                  verdict:
                    aiVerification.verdict === 'genuine'
                      ? 'verified'
                      : aiVerification.verdict === 'suspicious'
                        ? 'suspicious'
                        : 'invalid',
                  confidence: aiVerification.confidence_score ?? null,
                }
              : v,
          ),
        );
      }

      if (application) {
        const verdict =
          aiVerification?.verdict === 'genuine'
            ? 'verified'
            : aiVerification?.verdict === 'suspicious'
              ? 'suspicious'
              : 'invalid';

        addNotification({
          recipient_role: 'student',
          recipient_id: application.student_id,
          type: 'verification_result_student',
          title: 'AI Verification Result',
          message: `Your certificate AI verification result is ${aiVerification?.verdict}.`,
          application_id: application.id,
          student_id: application.student_id,
          job_id: application.job_id,
        });
      }

      pushToast(
        response.message || 'AI forgery verification completed',
        'success',
      );
    }, [
      session,
      verifications,
      applications,
      addNotification,
      pushToast,
    ]);

  const getNotificationsFor = useCallback((role: UserRole, userId: string): AppNotification[] => {
    return notifications.filter((n) => {
      if (n.recipient_role !== role) return false;
      // Match by entity id (institute_id, student_id, company_id) or user_id
      if (role === 'institute') return n.recipient_id === userId || institutes.some((i) => i.user_id === userId && i.id === n.recipient_id);
      if (role === 'student') return n.recipient_id === userId || students.some((s) => s.user_id === userId && s.id === n.recipient_id);
      if (role === 'company') return n.recipient_id === userId || companies.some((c) => c.user_id === userId && c.id === n.recipient_id);
      return false;
    });
  }, [notifications, institutes, students, companies]);

  const markNotificationRead = useCallback((id: string) => {
    setNotifications((prev) => prev.map((n) => (n.id === id ? { ...n, read: true } : n)));
  }, []);

  const markAllNotificationsRead = useCallback((role: UserRole, userId: string) => {
    const relevant = getNotificationsFor(role, userId).map((n) => n.id);
    setNotifications((prev) => prev.map((n) => (relevant.includes(n.id) ? { ...n, read: true } : n)));
  }, [getNotificationsFor]);

  // ---- Helpers ----
  const getStudentRecords = useCallback((studentId: string) => records.filter((r) => r.student_id === studentId), [records]);
  const getStudentApplications = useCallback((studentId: string) => applications.filter((a) => a.student_id === studentId), [applications]);
  const getCompanyApplications = useCallback((companyId: string) => applications.filter((a) => a.company_id === companyId), [applications]);
  const getInstituteStudents = useCallback((instituteId: string) => students.filter((s) => s.institute_id === instituteId), [students]);
  const getInstituteRecords = useCallback((instituteId: string) => records.filter((r) => r.institute_id === instituteId), [records]);
  const getVerificationForApplication = useCallback((applicationId: string) => verifications.filter((v) => v.application_id === applicationId).sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())[0], [verifications]);
  const getCertificateForApplication = useCallback((applicationId: string) => certificates.find((c) => c.application_id === applicationId), [certificates]);
  const getJobById = useCallback((id: string) => jobs.find((j) => j.id === id), [jobs]);
  const getStudentById = useCallback((id: string) => students.find((s) => s.id === id), [students]);
  const getCompanyById = useCallback((id: string) => companies.find((c) => c.id === id), [companies]);
  const getInstituteById = useCallback((id: string) => institutes.find((i) => i.id === id), [institutes]);
  const getRecordById = useCallback((id: string) => records.find((r) => r.id === id), [records]);
  const getApplicationById = useCallback((id: string) => applications.find((a) => a.id === id), [applications]);

  const value: StoreContextValue = {
    session, login, register, logout,
    users, institutes, students, companies, records, certificates, jobs, applications, verifications, notifications,
    addStudent, addAcademicRecord, updateAcademicRecord, uploadCertificate, approveApplication, rejectApplication,
    applyToJob,
    postJob, requestVerification, payForVerification, verifyOnBlockchain, verifyWithAI,
    getNotificationsFor, markNotificationRead, markAllNotificationsRead,
    toasts, pushToast, dismissToast,
    getStudentRecords, getStudentApplications, getCompanyApplications,
    getInstituteStudents, getInstituteRecords,
    getVerificationForApplication, getCertificateForApplication,
    getJobById, getStudentById, getCompanyById, getInstituteById, getRecordById, getApplicationById,
  };

  return <StoreContext.Provider value={value}>{children}</StoreContext.Provider>;
}

