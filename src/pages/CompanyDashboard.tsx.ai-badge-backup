function PostJobModal({ open, onClose }: { open: boolean; onClose: () => void }) {
  const { postJob } = useStore();
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [requirements, setRequirements] = useState('');
  const [location, setLocation] = useState('');
  const [salaryRange, setSalaryRange] = useState('');

  function handleSubmit() {
    if (!title.trim() || !description.trim() || !requirements.trim()) return;
    postJob({ title, description, requirements, location, salaryRange });
    setTitle(''); setDescription(''); setRequirements(''); setLocation(''); setSalaryRange('');
    onClose();
  }

  return (
    <Modal open={open} onClose={onClose} title="Post a Job" subtitle="Create a new job listing visible to all students" size="lg">
      <div className="space-y-4">
        <div>
          <label className="label-text">Job Title</label>
          <input className="input-field" placeholder="e.g. Junior Software Engineer" value={title} onChange={(e) => setTitle(e.target.value)} />
        </div>
        <div>
          <label className="label-text">Description</label>
          <textarea className="input-field min-h-[80px] resize-none" placeholder="Describe the role and responsibilities..." value={description} onChange={(e) => setDescription(e.target.value)} />
        </div>
        <div>
          <label className="label-text">Requirements</label>
          <textarea className="input-field min-h-[60px] resize-none" placeholder="List the qualifications and skills required..." value={requirements} onChange={(e) => setRequirements(e.target.value)} />
        </div>
        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="label-text">Location</label>
            <input className="input-field" placeholder="Bangalore, India" value={location} onChange={(e) => setLocation(e.target.value)} />
          </div>
          <div>
            <label className="label-text">Salary Range</label>
            <input className="input-field" placeholder="₹8-12 LPA" value={salaryRange} onChange={(e) => setSalaryRange(e.target.value)} />
          </div>
        </div>
      <div className="flex gap-3 pt-2">
          <button onClick={onClose} className="btn-secondary flex-1">Cancel</button>
          <button onClick={handleSubmit} className="btn-primary flex-1"><Plus className="w-4 h-4" />Post Job</button>
        </div>
      </div>
    </Modal>
  );
}

